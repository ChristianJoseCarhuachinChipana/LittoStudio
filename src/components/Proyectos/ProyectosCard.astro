---
const { title, img, alt } = Astro.props;
---

<div class="w-full lg:w-88">
	<div class="aspect-[16/10] w-full overflow-hidden rounded-3xl sm:aspect-[4/3] lg:aspect-auto lg:h-43">
		<img
			src={img}
			alt={alt}
			loading="lazy"
			decoding="async"
			class="h-full w-full object-cover"
		/>
	</div>
	<h3 class="mt-3 text-center text-base tracking-[.18em] sm:text-lg lg:mt-0 lg:tracking-[.25em]">
		{title}
	</h3>
</div>
