---
import ProyectosCard from './ProyectosCard.astro';
import ProyectosData from './ProyectosData.astro';
import belalbaImg from '@/assets/proyectos/belalba.png';
import borgonoImg from '@/assets/proyectos/borgono.jpg';
import cannelleImg from '@/assets/proyectos/cannelle.png';
import casaDrImg from '@/assets/proyectos/casa_dr.png';
import noxImg from '@/assets/proyectos/nox.jpg';
import parkLivingImg from '@/assets/proyectos/park_living.jpg';

const proyectos = [
	{
		title: 'Belalba',
		img: belalbaImg.src,
		alt: 'Proyecto Belalba',
	},
	{
		title: 'Borgoño',
		img: borgonoImg.src,
		alt: 'Proyecto Borgoño',
	},
	{
		title: 'Cada DR',
		img: casaDrImg.src,
		alt: 'Proyecto Cada DR',
	},
	{
		title: 'Cannelle',
		img: cannelleImg.src,
		alt: 'Proyecto Cannelle',
	},
	{ title: 'Nox', img: noxImg.src, alt: 'Proyecto Nox' },
	{
		title: 'Park Living',
		img: parkLivingImg.src,
		alt: 'Proyecto Park Living',
	},
];

const proyectosData = [
	{
		value: '+25',
		description: 'Proyectos desarrollados',
	},
	{
		value: '45%',
		description: 'Residencial',
	},
	{
		value: '55%',
		description: 'Inmobiliarios',
	},
];
---

<section
	id="proyectos-section"
	class="bg-background-light flex items-center justify-center"
>
	<div class="flex w-full max-w-7xl flex-col gap-12 px-6 py-14 sm:px-10 lg:flex-row lg:gap-0">
		<div class="relative order-2 w-full lg:order-1 lg:w-3/5">
			<div class="grid grid-cols-1 gap-x-5 gap-y-10 sm:grid-cols-2 sm:gap-y-12 lg:flex lg:flex-wrap lg:justify-between lg:gap-x-0 lg:gap-y-3">
				{proyectos.map((proyecto) => (
					<ProyectosCard
						title={proyecto.title}
						img={proyecto.img}
						alt={proyecto.alt}
					/>
				))}
			</div>
			<div id="mask" class="absolute size-full bottom-0"></div>
		</div>
		<div class="order-1 w-full lg:order-2 lg:w-2/5 xl:pl-[6%] flex flex-col">
			<div class="lg:my-5">
				<h2
					id="proyectos-title"
					class="mb-4 text-4xl font-bold text-textColor sm:mb-5 sm:text-5xl"
				>
					Proyectos
				</h2>
				<div
					id="proyectos-text"
					class="text-base/7 tracking-[.18em] sm:text-lg/8 sm:tracking-[.22em] lg:text-lg/5 lg:tracking-[.25em]"
				>
					<p>
						Una muestra de proyectos donde el diseño aporta valor, identidad y
						propósito a cada espacio.
					</p>
				</div>
			</div>
			<div
				id="proyectos-data"
				class="flex w-full flex-col gap-8 sm:grid sm:grid-cols-3 sm:items-start sm:gap-6 sm:my-12 lg:mx-5 lg:my-20 lg:flex lg:flex-col lg:gap-y-10"
			>
				{proyectosData.map((data) => (
					<ProyectosData value={data.value} description={data.description} />
				))}
			</div>
		</div>
	</div>
</section>

<script>
	import { gsap } from 'gsap';

	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const mm = gsap.matchMedia();

	const proyectosSection = document.querySelector('#proyectos-section');
	const mask = document.querySelector('#mask');
	const bgLight = getComputedStyle(proyectosSection).backgroundColor;

	gsap.fromTo(
		mask,
		{
			height: '100%',
			backgroundImage: `linear-gradient(to top, ${bgLight} 100%, transparent)`,
		},
		{
			height: '0%',
			backgroundImage: `linear-gradient(to top, ${bgLight} 0%, transparent)`,
			duration: 5,
			ease: 'power3.out',
			scrollTrigger: {
				trigger: proyectosSection,
				start: 'top center',
			},
		},
	);

	const proyectosText = document.querySelector('#proyectos-text');
	const proyectosTitle = document.querySelector('#proyectos-title');
	const proyectosData = document.querySelector('#proyectos-data');

	mm.add('(min-width: 1025px)', () => {
		const tl = gsap.timeline({
			scrollTrigger: {
				trigger: proyectosSection,
				start: 'top center',
				end: 'bottom top',
				scrub: false,
			},
		});

		tl.from(proyectosTitle, {
			opacity: 0,
			scale: 1.2,
			duration: 3,
			ease: 'power3.out',
		});

		tl.from(
			proyectosText,
			{
				opacity: 0,
				x: '10%',
				duration: 3,
				ease: 'power3.out',
			},
			'-=1.5',
		);

		tl.from(
			proyectosData,
			{
				opacity: 0,
				scale: 0.5,
				duration: 3,
				ease: 'power3.out',
			},
			'-=2.5',
		);
	});

	mm.add('(max-width: 1024px)', () => {
		const tl = gsap.timeline({
			scrollTrigger: {
				trigger: proyectosSection,
				start: 'top center',
				end: 'bottom top',
				scrub: false,
			},
		});

		tl.from(proyectosTitle, {
			opacity: 0,
			scale: 0.8,
			duration: 3,
			ease: 'power3.out',
		});

		tl.from(
			proyectosText,
			{
				opacity: 0,
				y: '50%',
				duration: 3,
				ease: 'power3.out',
			},
			'-=1.5',
		);

		tl.from(
			proyectosData,
			{
				opacity: 0,
				scale: 0.5,
				duration: 3,
				ease: 'power3.out',
			},
			'-=2.5',
		);
	});
</script>
