---
const { value, description } = Astro.props;
---

<div class="flex w-full flex-col gap-1 sm:gap-2 lg:flex-row lg:justify-between lg:gap-0">
	<div class="w-full lg:w-4/9">
		<p class="text-4xl tracking-[.18em] sm:text-5xl sm:tracking-[.22em] lg:tracking-[.25em]">
			{value}
		</p>
	</div>
	<div class="w-full lg:w-5/9">
		<p class="text-base tracking-[.18em] sm:text-lg sm:tracking-[.22em] lg:text-xl lg:tracking-[.25em]">
			{description}
		</p>
	</div>
</div>
