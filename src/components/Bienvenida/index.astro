---
import HeroImg from '@/assets/hero.png';
import HeroVideo from '@/assets/hero.mp4';
---

<section class="relative h-dvh">
	<div class="w-full h-full overflow-hidden relative">
		<img
			id="hero-fallback"
			src={HeroImg.src}
			alt="Hero"
			class="absolute inset-0 w-full h-full object-cover"
		/>
		<video
			id="hero-video"
			src={HeroVideo}
			autoplay
			muted
			playsinline
			preload="auto"
			class="absolute inset-0 w-full h-full object-cover"
		></video>
	</div>
	<div class="w-full max-w-7xl px-10 h-full absolute z-2 top-0 inset-x-0 mx-auto">
		<div id="logo" class="absolute top-9/30 left-1/11">
			<div class="relative">
				<p class="text-9xl font-bold tracking-tight text-primary">Litto</p>
				<p class="absolute top-28 left-2.5 text-3xl font-black tracking-[.2em] text-primary">
					STUDIO
				</p>
			</div>
		</div>
		<div id="texto1" class="absolute top-14 right-10">
			<div class="relative">
				<p class="text-sm tracking-[.2em] text-primary">LIMA, PERÚ</p>
			</div>
		</div>
		<div id="texto2" class="absolute top-38 right-10 flex">
			<div class="relative">
				<p class="absolute top-4 -left-5 text-4xl font-bold text-primary">+</p>
				<p class="text-3xl font-bold text-primary">arquitectura</p>
				<p class="text-3xl font-bold text-justify text-primary">interiorismo</p>
			</div>
		</div>
		<div
			id="contactanos"
			class="absolute bottom-20 right-10 border-3 border-white px-6 py-3 text-white tracking-[.2em] underline"
		>
			<a
				href="https://wa.me/51956241794?text=Hola%20Katherine,%20vi%20el%20portafolio%20de%20Litto%20Studio%20y%20me%20gustar%C3%ADa%20conocer%20m%C3%A1s%20sobre%20sus%20servicios."
				target="_blank"
			>
				CONTÁCTANOS
			</a>
		</div>
	</div>
</section>

<script>
	import { gsap } from 'gsap';

	const init = () => {
		const heroVideo = document.querySelector<HTMLVideoElement>('#hero-video');
		const texto1 = document.querySelector('#texto1');
		const texto2 = document.querySelector('#texto2');
		const contactanos = document.querySelector('#contactanos');
		const logo = document.querySelector('#logo');

		let mostrado = false;
		const mostrar = () => {
			if (mostrado) return;
			mostrado = true;

			const tl = gsap.timeline();

			tl.fromTo(
				texto1,
				{ opacity: 0, y: '50%' },
				{ opacity: 1, y: 0, duration: 1.5, ease: 'power3.out' },
			);
			tl.fromTo(
				texto2,
				{ opacity: 0, y: '50%' },
				{ opacity: 1, y: 0, duration: 1.5, ease: 'power3.out' },
				'-=1.5',
			);
			tl.fromTo(
				contactanos,
				{ opacity: 0, y: '50%' },
				{ opacity: 1, y: 0, duration: 1.5, ease: 'power3.out' },
				'-=1',
			);
			tl.fromTo(
				logo,
				{ scale: 1.5, x: '2.5%', opacity: 0 },
				{
					scale: 1,
					x: '2.5%',
					opacity: 1,
					duration: 2.5,
					ease: 'power4.out',
				},
				'-=1.5',
			);
		};

		gsap.set([logo, texto1, texto2, contactanos], { opacity: 0 });

		if (!heroVideo) {
			mostrar();
			return;
		}

		const falla = () => {
			heroVideo.style.display = 'none';
			mostrar();
		};

		const superponer = () => {
			gsap.to(heroVideo, {
				opacity: 0,
				duration: 1,
				ease: 'power2.out',
				onComplete: () => {
					heroVideo.style.display = 'none';
				},
			});
		};

		heroVideo.addEventListener('ended', () => {
			superponer();
			mostrar();
		});
		heroVideo.addEventListener('error', falla);

		if (heroVideo.error) {
			falla();
			return;
		}

		heroVideo.play().catch(falla);

		window.setTimeout(mostrar, 12000);
	};

	init();
</script>
