---
const { img, alt } = Astro.props;
---

<section data-imagen-section class="w-full">
	<div class="relative flex h-[32svh] min-h-[22rem] w-full items-center justify-center overflow-hidden sm:h-[36svh] sm:min-h-[26rem] lg:h-190 lg:min-h-0">
		<img
			src={img}
			alt={alt}
			loading="lazy"
			decoding="async"
			class="absolute inset-0 h-full w-full lg:translate-y-[-3%] object-cover lg:static lg:h-auto lg:w-full"
		/>
	</div>
</section>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	const sections = document.querySelectorAll<HTMLElement>(
		'[data-imagen-section]',
	);

	sections.forEach((section) => {
		gsap.fromTo(
			section,
			{
				filter: 'blur(10px)',
				opacity: 0.2,
			},
			{
				filter: 'blur(0px)',
				opacity: 1,
				duration: 2,
				ease: 'power2.out',
				scrollTrigger: {
					trigger: section,
					start: 'top 80%',
				},
			},
		);
	});
</script>
