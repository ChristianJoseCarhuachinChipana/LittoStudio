---
import NosotrosImg from '@/assets/nosotros.png';
---

<section
	id="nosotros-section"
	class="bg-background flex items-center justify-center"
>
	<div class="max-w-7xl w-full flex py-14 px-10">
		<div class="w-9/19 pr-[10%] flex items-center">
			<div id="nosotros-text">
				<h2 class="text-5xl font-bold text-white mb-10">Nuestra esencia</h2>
				<div class="text-lg/5 tracking-[.25em]">
					<p>
						Creemos en el diseño como una herramienta para crear espacios con
						identidad, carácter y significado.
					</p>
					<br />
					<br />
					<p>
						En Litto Studio desarrollamos proyectos residenciales e
						inmobiliarios desde una visión estratégica y colaborativa,
						transformando ideas en espacios que aportan valor y responden a una
						intención clara de diseño.
					</p>
				</div>
			</div>
		</div>
		<div id="nosotros-image" class="w-10/19">
			<div class="rounded-[15%] overflow-hidden aspect-32/33">
				<img
					src={NosotrosImg.src}
					alt="Nosotros"
					class="w-full translate-y-[-10%]"
				/>
			</div>
		</div>
	</div>
</section>

<script>
	import { gsap } from 'gsap';

	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { SplitText } from 'gsap/SplitText';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	const nosotrosSection = document.querySelector('#nosotros-section');
	const nosotrosImg = document.querySelector('#nosotros-image');
	const nosotrosImgHeight = nosotrosImg.getBoundingClientRect().height;

	gsap.fromTo(
		nosotrosImg,
		{ y: window.innerHeight - nosotrosImgHeight, opacity: 0.1 },
		{
			scrollTrigger: {
				trigger: nosotrosSection,
				start: 'top center',
				end: 'bottom bottom',
				scrub: true,
			},
			y: 0,
			opacity: 1,
		},
	);

	const nosotrosText = document.querySelector('#nosotros-text');

	const split = SplitText.create(nosotrosText, { type: 'words, lines' });
	gsap.from(split.lines, {
		x: '30%',
		y: '30%',
		opacity: 0,
		duration: 0.7,
		ease: 'power3.out',
		stagger: 0.5,
		scrollTrigger: {
			trigger: nosotrosSection,
			start: 'top center',
			end: 'top top',
			scrub: true,
		},
	});
</script>
