---
import NosotrosImg from '@/assets/nosotros.png';
---

<section
	id="nosotros-section"
	class="bg-background flex items-center justify-center"
>
	<div class="flex w-full max-w-7xl flex-col gap-10 px-6 py-14 sm:gap-12 sm:px-10 lg:flex-row lg:gap-0 lg:py-14">
		<div class="flex w-full items-center lg:w-9/19 lg:pr-[10%]">
			<div id="nosotros-text">
				<h2 class="mb-6 text-4xl font-bold text-white sm:text-5xl lg:mb-10">
					Nuestra esencia
				</h2>
				<div class="text-base/7 tracking-[.15em] sm:text-lg/8 sm:tracking-[.2em] lg:text-lg/5 lg:tracking-[.25em]">
					<p>
						Creemos en el diseño como una herramienta para crear espacios con
						identidad, carácter y significado.
					</p>
					<br />
					<br />
					<p>
						En Litto Studio desarrollamos proyectos residenciales e
						inmobiliarios desde una visión estratégica y colaborativa,
						transformando ideas en espacios que aportan valor y responden a una
						intención clara de diseño.
					</p>
				</div>
			</div>
		</div>
		<div
			id="nosotros-image"
			class="w-full sm:mx-auto sm:max-w-2xl lg:mx-0 lg:w-10/19 lg:max-w-none"
		>
			<div class="relative aspect-[3/4] overflow-hidden rounded-[2rem] sm:aspect-[16/10] sm:rounded-[3rem] lg:aspect-32/33 lg:rounded-[15%]">
				<img
					src={NosotrosImg.src}
					alt="Nosotros"
					loading="lazy"
					decoding="async"
					class="absolute inset-0 h-full w-full lg:translate-y-[-10%] object-cover lg:static lg:h-auto lg:w-full"
				/>
			</div>
		</div>
	</div>
</section>

<script>
	import { gsap } from 'gsap';

	import { ScrollTrigger } from 'gsap/ScrollTrigger';
	import { SplitText } from 'gsap/SplitText';

	gsap.registerPlugin(ScrollTrigger, SplitText);

	const mm = gsap.matchMedia();

	const nosotrosSection = document.querySelector('#nosotros-section');
	const nosotrosImg = document.querySelector('#nosotros-image');
	const nosotrosImgHeight = nosotrosImg.getBoundingClientRect().height;

	gsap.fromTo(
		nosotrosImg,
		{ y: window.innerHeight - nosotrosImgHeight, opacity: 0.1 },
		{
			scrollTrigger: {
				trigger: nosotrosSection,
				start: 'top center',
				end: 'bottom bottom',
				scrub: true,
			},
			y: 0,
			opacity: 1,
		},
	);

	const nosotrosText = document.querySelector('#nosotros-text');

	const split = SplitText.create(nosotrosText, { type: 'words, lines' });

	mm.add('(min-width: 1025px)', () => {
		gsap.from(split.lines, {
			x: '30%',
			y: '30%',
			opacity: 0,
			duration: 0.7,
			ease: 'power3.out',
			stagger: 0.5,
			scrollTrigger: {
				trigger: nosotrosSection,
				start: 'top center',
				end: 'top top',
				scrub: true,
			},
		});
	});

	mm.add('(max-width: 1024px)', () => {
		gsap.from(split.lines, {
			y: '30%',
			opacity: 0,
			duration: 0.7,
			ease: 'power3.out',
			stagger: 0.5,
			scrollTrigger: {
				trigger: nosotrosSection,
				start: 'top center',
				end: 'top top',
				scrub: true,
			},
		});
	});
</script>
