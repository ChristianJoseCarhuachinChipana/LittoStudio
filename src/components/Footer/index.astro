---
const emailAddress = 'littosttudio@gmail.com';
const phoneDisplay = '+51 956 241 794';
const phoneHref =
	'https://wa.me/51956241794?text=Hola%20Katherine,%20vi%20el%20portafolio%20de%20Litto%20Studio%20y%20me%20gustar%C3%ADa%20conocer%20m%C3%A1s%20sobre%20sus%20servicios.';

interface SocialLink {
	name: string;
	href: string;
	icon: 'facebook' | 'instagram' | 'linkedin';
}

const socialLinks: SocialLink[] = [
	{
		name: 'Facebook',
		href: 'https://example.com/litto-studio-facebook',
		icon: 'facebook',
	},
	{
		name: 'LinkedIn',
		href: 'https://example.com/litto-studio-linkedin',
		icon: 'linkedin',
	},
	{
		name: 'Instagram',
		href: 'https://example.com/litto-studio-instagram',
		icon: 'instagram',
	},
];
---

<footer
	id="footer-section"
	aria-labelledby="footer-title"
	class="bg-[#ccd2cf] text-primary"
>
	<div class="mx-auto w-full max-w-7xl px-10 py-16 lg:py-24">
		<div class="grid gap-10 lg:grid-cols-[1.35fr_.65fr] lg:items-start">
			<h2
				id="footer-title"
				class="font-serif text-4xl leading-[1.05] font-medium text-white sm:text-5xl lg:text-6xl"
			>
				<span data-footer-line class="block">
					Cada proyecto comienza
				</span>
				<span data-footer-line class="block">
					con una conversación.
				</span>
			</h2>

			<p
				data-footer-meta
				class="flex items-start gap-3 text-3xl leading-tight font-medium lg:justify-end lg:pt-3 lg:text-right"
			>
				<span aria-hidden="true" class="text-3xl font-bold leading-none">
					+
				</span>
				<span>
					arquitectura
					<br />
					interiorismo
				</span>
			</p>
		</div>

		<div
			aria-hidden="true"
			data-footer-rule
			class="mt-12 h-px origin-left bg-primary/20 lg:mt-16"
		></div>

		<div class="mt-10 grid gap-10 md:grid-cols-2 md:items-end lg:mt-14">
			<div data-footer-person>
				<p class="font-serif text-2xl text-white sm:text-3xl">
					Katherine Luján Oré
				</p>
				<p class="mt-2 text-xs tracking-[.3em] uppercase sm:text-sm">
					Founder &amp; Creative Director
				</p>
			</div>
			<address
				data-footer-contact
				class="text-sm tracking-[.2em] break-words not-italic sm:text-base md:text-right"
			>
				<a
					class="block underline decoration-primary/30 underline-offset-8 transition-colors duration-300 hover:text-primary/70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary/60"
					href={`mailto:${emailAddress}`}
				>
					{emailAddress}
				</a>
				<a
					class="mt-3 block underline decoration-primary/30 underline-offset-8 transition-colors duration-300 hover:text-primary/70 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary/60"
					href={phoneHref}
					target="_blank"
				>
					{phoneDisplay}
				</a>
				<ul
					aria-label="Redes sociales temporales"
					class="mt-6 flex gap-4 md:justify-end"
					data-footer-social
				>
					{socialLinks.map((social) => (
						<li>
							<a
								aria-label={`${social.name} de Litto Studio (enlace temporal)`}
								class="flex size-11 items-center justify-center rounded-full border border-primary/40 transition-colors duration-300 hover:bg-primary hover:text-[#ccd2cf] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary/60"
								href={social.href}
								rel="noreferrer"
								target="_blank"
							>
								{social.icon === 'facebook' && (
									<svg
										aria-hidden="true"
										class="size-5"
										fill="currentColor"
										viewBox="0 0 24 24"
									>
										<path d="M13.5 21v-6.5h2.2l.3-2.5h-2.5V10.4c0-.7.2-1.2 1.2-1.2h1.3V6.9c-.3 0-1.1-.1-2-.1-2 0-3.3 1.2-3.3 3.4V12H8.2v2.5h2.5V21h2.8z" />
									</svg>
								)}
								{social.icon === 'linkedin' && (
									<svg
										aria-hidden="true"
										class="size-5"
										fill="currentColor"
										viewBox="0 0 24 24"
									>
										<path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45z" />
									</svg>
								)}
								{social.icon === 'instagram' && (
									<svg
										aria-hidden="true"
										class="size-5"
										fill="none"
										stroke="currentColor"
										stroke-width="1.8"
										viewBox="0 0 24 24"
									>
										<rect x="4" y="4" width="16" height="16" rx="4.5" />
										<circle cx="12" cy="12" r="3.8" />
										<circle
											cx="17"
											cy="7"
											r="1.1"
											fill="currentColor"
											stroke="none"
										/>
									</svg>
								)}
							</a>
						</li>
					))}
				</ul>
			</address>
		</div>
	</div>
</footer>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	type CleanupWindow = Window & { __footerCleanup?: () => void };

	const win = window as CleanupWindow;
	const section = document.querySelector<HTMLElement>('#footer-section');

	if (section) {
		win.__footerCleanup?.();

		const lines = Array.from(
			section.querySelectorAll<HTMLElement>('[data-footer-line]'),
		);
		const meta = section.querySelector<HTMLElement>('[data-footer-meta]');
		const rule = section.querySelector<HTMLElement>('[data-footer-rule]');
		const person = section.querySelector<HTMLElement>('[data-footer-person]');
		const contact = section.querySelector<HTMLElement>('[data-footer-contact]');
		const socialLinks = Array.from(
			section.querySelectorAll<HTMLAnchorElement>('[data-footer-social] a'),
		);
		let teardown: (() => void) | undefined;

		function showFooterContent() {
			gsap.set([lines, meta, rule, person, contact, socialLinks], {
				opacity: 1,
				x: 0,
				y: 0,
				scaleX: 1,
			});
		}

		const ctx = gsap.context(() => {
			const mm = gsap.matchMedia();

			mm.add(
				{
					desktop:
						'(min-width: 1024px) and (prefers-reduced-motion: no-preference)',
					desktopReduce:
						'(min-width: 1024px) and (prefers-reduced-motion: reduce)',
					mobile:
						'(max-width: 1023px) and (prefers-reduced-motion: no-preference)',
					mobileReduce:
						'(max-width: 1023px) and (prefers-reduced-motion: reduce)',
				},
				(mmCtx) => {
					const conditions = mmCtx.conditions as Record<string, boolean>;
					const isDesktop = Boolean(conditions.desktop);
					const animate = isDesktop || Boolean(conditions.mobile);

					if (!animate) {
						showFooterContent();
						return;
					}

					const rise = isDesktop ? 56 : 28;
					const timeline = gsap.timeline({
						scrollTrigger: {
							trigger: section,
							start: 'top 82%',
							once: true,
						},
					});

					timeline
						.fromTo(
							rule,
							{ scaleX: 0, opacity: 0 },
							{
								scaleX: 1,
								opacity: 1,
								duration: 1,
								ease: 'power3.out',
							},
							0,
						)
						.fromTo(
							lines,
							{ y: rise, opacity: 0 },
							{
								y: 0,
								opacity: 1,
								duration: 1.1,
								ease: 'power3.out',
								stagger: 0.12,
							},
							0.05,
						)
						.fromTo(
							meta,
							{ y: rise * 0.6, opacity: 0 },
							{
								y: 0,
								opacity: 1,
								duration: 0.9,
								ease: 'power3.out',
							},
							0.15,
						)
						.fromTo(
							[person, contact],
							{ y: rise * 0.5, opacity: 0 },
							{
								y: 0,
								opacity: 1,
								duration: 0.9,
								ease: 'power3.out',
								stagger: 0.12,
							},
							0.25,
						)
						.fromTo(
							socialLinks,
							{ y: rise * 0.35, opacity: 0 },
							{
								y: 0,
								opacity: 1,
								duration: 0.7,
								ease: 'power3.out',
								stagger: 0.08,
							},
							0.5,
						);
				},
			);

			teardown = () => {
				mm.revert();
			};
		});

		win.__footerCleanup = () => {
			teardown?.();
			ctx.revert();
			win.__footerCleanup = undefined;
		};
	}
</script>
